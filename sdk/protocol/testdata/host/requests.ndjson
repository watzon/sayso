# hello with everything
{"type":"hello","sdk":"sayso-go/0.17.2","protocol":1,"features":[],"app":{"name":"Notetaker"},"capabilities":["models.read","models.download","transcribe.file","session.live","audio.mic","audio.system","ai.enhance","dictation.observe"],"v":1,"id":"h1"}
# hello with the fields that it needs
{"type":"hello","protocol":1,"features":[],"v":1,"id":"h2"}
# list_models
{"type":"list_models","v":1,"id":"1"}
