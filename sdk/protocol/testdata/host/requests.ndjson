{"type":"transcribe_file","path":"/Users/a/meeting.m4a","model":"parakeet-tdt-v3","vad_model":"silero-vad","language":"en","diarize":true,"diarization_model":"pyannote-community-1","speakers":2,"v":1,"id":"4"}
