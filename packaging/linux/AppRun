#!/bin/sh
# The start command of the AppImage. Sayso takes its libraries from the
# system. usr/lib/fallback has a copy of each library that a system can be
# without. A copy is used only when the system has no such library: a copy of
# libxkbcommon from the build system cannot read the keyboard data of a newer
# system.
here=$(dirname "$(readlink -f "$0")")
app="$here/usr/bin/sayso"
# The dynamic linker lists the libraries that it cannot find. A library that
# is not found hides the ones it needs, so ask again after each addition.
while :; do
  added=
  for lib in $(LD_TRACE_LOADED_OBJECTS=1 "$app" 2>/dev/null | sed -n 's/^[[:space:]]*\([^ ]*\) => not found.*/\1/p'); do
    [ -d "$here/usr/lib/fallback/$lib" ] || continue
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$here/usr/lib/fallback/$lib"
    added=1
  done
  [ -n "$added" ] || break
  export LD_LIBRARY_PATH
done
exec "$app" "$@"
